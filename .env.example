# Jira Cloud 접속 정보 (로컬 실행 시 .env 로 복사하여 사용).
# GitHub Actions에서는 저장소 Secrets 로 등록합니다 (README 참고).

# Jira 인스턴스 베이스 URL (끝 슬래시 없이)
JIRA_BASE_URL=https://bfly.atlassian.net

# Jira 계정 이메일
JIRA_EMAIL=you@example.com

# Jira API 토큰 (https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급)
JIRA_API_TOKEN=your_api_token_here
